    <!-- BIRTHDAY -->
    <!-- .................................BIRTHDAY.............................................. -->
    <string name="title_birthday">Celebraciones en arcadebits</string>

    <string name="birthday_title_intro_text">Introducción</string>
    <string name="birthday_intro_text">Con más de 7 años liderando la organización de eventos gamer en Almería, en Arcade Bits creamos experiencias únicas para los más pequeños. Nuestro equipo de monitores profesionales acompaña y anima cada partida, garantizando diversión y seguridad. Hemos impulsado iniciativas como XpoBit, Hibernum, XpoManga, Ejido Games Xpo y el Circuito Provincial de eSports.
Además, somos fundadores de EVI (Escuela de Videojuegos Inclusivos) y colaboradores de la Sala Gaming del Materno Infantil en Torrecárdenas, llevando el videojuego a todos los rincones.
    </string>

    <string name="birthday_title_gaming_room_text">Sala gaming</string>
    <string name="birthday_gamer_room_text">
        Nuestra Sala es el epicentro de la diversión para los cumpleañeros más “gamer” de Almería, con 7 años de experiencia ofreciendo partidas inolvidables. Con capacidad para 16 jugadores y monitores expertos siempre disponibles, disfrutará de apoyo y entretenimiento continuo.
    </string>

    <string name="birthday_title_available_areas_text">Zonas disponibles</string>
    <string name="birthday_available_areas_text"><![CDATA[
        • <b>Torneos</b>: 4 stands gaming con Fortnite, Fall Guys, Rocket League, Spiderman, Crash Bandicoot, etc.<br/>
        • <b>Multijugador</b>: 3 stands gaming para Smash Bros, Mario Kart, Minecraft, Roblox y más.<br/>
        • <b>Novedades</b>: 2 stands gaming con los último en videojuegos, GamePass, Playstation Plus...<br/>
        • <b>Clásicos</b>: 3 setups con títulos retro que no envejecen.
    ]]>
    </string>

    <string name="birthday_title_schedules_text">Horarios</string>
    <string name="birthday_schedule_text"><![CDATA[
